{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ianel",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Angular's application builder outputs here (outputPath defaults to dist/<project>/browser)
    "directory": "./dist/ianel-web/browser",
    // Serve index.html for client-side routes (Angular router)
    "not_found_handling": "single-page-application"
  }
}
